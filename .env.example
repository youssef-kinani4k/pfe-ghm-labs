# Copier en .env et renseigner. Le backend lit ces variables via application.yml.

# Base de donnees
DB_URL=jdbc:postgresql://localhost:5432/leadflow
DB_USER=leadflow
DB_PASSWORD=leadflow

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=leadflow
RABBITMQ_PASSWORD=leadflow

# Secret partage avec les sites clients pour signer les webhooks (HMAC-SHA256)
WEBHOOK_HMAC_SECRET=

# API REST Dolibarr (le token se genere dans Dolibarr : Utilisateur > Cle API)
DOLIBARR_BASE_URL=http://localhost:8081/api/index.php
DOLIBARR_API_KEY=
