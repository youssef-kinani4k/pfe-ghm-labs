# Copier en .env et renseigner. Le backend lit ces variables via application.yml.

# Port HTTP du backend. Le defaut du projet est 8090 et non 8080 : le port par defaut de
# Tomcat est occupe en permanence sur le poste de developpement, et un demarrage qui echoue
# une fois sur deux coute plus cher qu'un port choisi. Le proxy Angular vise ce port.
SERVER_PORT=8090

# Base de donnees
DB_URL=jdbc:postgresql://localhost:5432/leadflow
DB_USER=leadflow
DB_PASSWORD=leadflow

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=leadflow
RABBITMQ_PASSWORD=leadflow

# Cle maitre de chiffrement des secrets stockes en base (client.hmac_secret,
# client.crm_config). AES-256 en base64 sur 32 octets. Obligatoire : sans elle
# l'application refuse de demarrer, plutot que de chiffrer avec une cle devinable.
# En generer une : openssl rand -base64 32
LEADFLOW_MASTER_KEY=

# Cle de signature des jetons du dashboard (HS256). Au moins 32 octets, sinon Nimbus
# refuse la cle au demarrage. Obligatoire hors profil dev, sans valeur de repli, pour la
# meme raison que la cle maitre.
# En generer une : openssl rand -base64 48
LEADFLOW_JWT_SECRET=

# Compte operateur du dashboard. Le mot de passe n'est JAMAIS stocke, meme ici : seul son
# hash BCrypt l'est. Il n'existe aucun ecran de gestion de comptes — en ajouter un se fait
# en dupliquant ce couple de variables sous leadflow.dashboard.users[1].
# Generer le hash : htpasswd -bnBC 10 "" 'mot-de-passe' | tr -d ':\n'
LEADFLOW_ADMIN_USER=admin
LEADFLOW_ADMIN_PASSWORD_HASH=

# Il n'y a volontairement aucune variable de connexion ERP ici. Le secret HMAC et les
# parametres d'acces a l'instance Dolibarr ou Odoo appartiennent a chaque client et
# vivent chiffres sur sa ligne de la table `client` — ajouter un client est une
# insertion en base, pas un redeploiement.
