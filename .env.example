# Copier en .env et renseigner. Le backend lit ces variables via application.yml.

# Base de donnees
DB_URL=jdbc:postgresql://localhost:5432/leadflow
DB_USER=leadflow
DB_PASSWORD=leadflow

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=leadflow
RABBITMQ_PASSWORD=leadflow

# Cle maitre de chiffrement des secrets stockes en base (client.hmac_secret,
# client.crm_config). AES-256 en base64 sur 32 octets. Obligatoire : sans elle
# l'application refuse de demarrer, plutot que de chiffrer avec une cle devinable.
# En generer une : openssl rand -base64 32
LEADFLOW_MASTER_KEY=

# Il n'y a volontairement aucune variable de connexion ERP ici. Le secret HMAC et les
# parametres d'acces a l'instance Dolibarr ou Odoo appartiennent a chaque client et
# vivent chiffres sur sa ligne de la table `client` — ajouter un client est une
# insertion en base, pas un redeploiement.
