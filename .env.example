# Copier en .env et renseigner. Le backend lit ces variables via application.yml.

# Base de donnees
DB_URL=jdbc:postgresql://localhost:5432/leadflow
DB_USER=leadflow
DB_PASSWORD=leadflow

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=leadflow
RABBITMQ_PASSWORD=leadflow

# Secret partage avec les sites clients pour signer les webhooks (HMAC-SHA256)
WEBHOOK_HMAC_SECRET=

# ERP/CRM cible par defaut (doit correspondre a une cle de leadflow.crm.providers)
CRM_DEFAULT_PROVIDER=dolibarr

# Connecteur Dolibarr (le token se genere dans Dolibarr : Utilisateur > Cle API)
DOLIBARR_BASE_URL=http://localhost:8081/api/index.php
DOLIBARR_API_KEY=

# Connecteur Odoo (la cle se genere dans Odoo : Preferences > Cle API developpeur)
ODOO_BASE_URL=http://localhost:8069
ODOO_DATABASE=leadflow
ODOO_USERNAME=
ODOO_API_KEY=
