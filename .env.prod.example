# Copier en .env.prod et renseigner CHAQUE valeur. Le fichier .env.prod est ignore par
# git ; ce fichier-ci, l'exemple, ne doit jamais contenir de vraie valeur.
#
#   cp .env.prod.example .env.prod

# --- Base de donnees ------------------------------------------------------------------
# POSTGRES_PASSWORD est lu par le conteneur Postgres, DB_PASSWORD par le backend : les
# deux doivent porter la meme valeur. Le nom d'hote est celui du service dans le compose.
POSTGRES_PASSWORD=
DB_URL=jdbc:postgresql://postgres:5432/leadflow
DB_USER=leadflow
DB_PASSWORD=

# --- RabbitMQ -------------------------------------------------------------------------
# Meme regle : RABBITMQ_DEFAULT_PASS est lu par le broker, RABBITMQ_PASSWORD par le
# backend. Aucun port n'est publie sur l'hote, console de gestion comprise.
RABBITMQ_DEFAULT_PASS=
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=leadflow
RABBITMQ_PASSWORD=

# --- Secrets de l'instance ------------------------------------------------------------
# Cle AES-256 des secrets stockes en base (client.hmac_secret, client.crm_config). Sa
# perte rend ces secrets irrecuperables : la sauvegarder ailleurs que sur la machine.
#   openssl rand -base64 32
LEADFLOW_MASTER_KEY=

# Cle de signature des jetons du dashboard (HS256). Au moins 32 octets.
#   openssl rand -base64 48
LEADFLOW_JWT_SECRET=

# Compte operateur. Le mot de passe n'est stocke nulle part, meme ici : seul son hash
# BCrypt l'est. Sans hash, l'application refuse de demarrer.
#   htpasswd -bnBC 10 "" 'mot-de-passe' | tr -d ':\n'
LEADFLOW_ADMIN_USER=admin
LEADFLOW_ADMIN_PASSWORD_HASH=

# --- Analyse d'intention --------------------------------------------------------------
# Seule variable qui puisse rester vide : l'analyse retombe alors sur le lexique. Elle
# n'est de toute facon qu'un repli, la cle enregistree depuis l'ecran « Parametres »
# l'emportant sur elle.
GEMINI_API_KEY=
